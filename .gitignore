# Ignore everything except the Next.js application and its required files.
/*
!/.gitignore
!/package.json
!/package-lock.json

# Next.js source, routes, styles, and configuration.
!/frontend/
/frontend/.next/
/frontend/out/
/frontend/node_modules/
/frontend/public/
/frontend/tsconfig.tsbuildinfo
/frontend/.env*
/frontend/AGENTS.md

# Scripts used by npm run dev and npm run build.
!/scripts/
/scripts/*
!/scripts/dev.mjs
!/scripts/prepare-next.mjs

# Canonical icons copied into the Next.js public directory at build time.
!/public/
/public/*
!/public/assets/
/public/assets/*
!/public/assets/icons/

# Local tooling, credentials, caches, and logs at any depth.
**/.agents/
**/.claude/
**/.codex/
**/.cursor/
**/.openai/
**/.env*
**/AGENTS.md
**/CLAUDE.md
**/GEMINI.md
**/.cursorrules
**/*.log
