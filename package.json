{
  "name": "phpmongo-ui",
  "private": true,
  "version": "1.0.0-dev",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/prepare-next.mjs && next build frontend --webpack",
    "test:browser": "node tests/browser.mjs",
    "test:import": "node tests/import-file.mjs",
    "test:assets": "node tests/next-assets.mjs",
    "package": "python3 scripts/package-release.py",
    "verify:release": "python3 scripts/verify-release.py",
    "predev": "node scripts/prepare-next.mjs",
    "start": "next start frontend --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --project frontend/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
