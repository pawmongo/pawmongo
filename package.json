{
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "dev:theme": "npm --prefix themes run dev",
    "dev:php": "php -S 127.0.0.1:8080 -t lib/public lib/public/router.php",
    "build": "node scripts/build.mjs",
    "build:theme": "npm --prefix themes run build",
    "package": "python3 scripts/package.py",
    "start": "node scripts/serve.mjs start",
    "install:theme": "npm --prefix themes install",
    "install:php": "composer --working-dir=lib install",
    "typecheck": "npm --prefix themes run typecheck",
    "test": "npm run typecheck && npm run test:php && npm run test:api",
    "test:php": "php lib/tests/run.php",
    "test:api": "node scripts/test-api.mjs",
    "test:live": "npm --prefix themes run test:live"
  }
}
